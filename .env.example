# ==============================================================================
# MANJUNATH BATTERIES — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Required: Lead Dispatch Destination Webhook URL
# The API endpoint (/api/callback) will return HTTP 503 (Service Unavailable)
# if this is not set, preventing false "Request Received" promises to customers.
# Supports:
# - Discord Webhook: https://discord.com/api/webhooks/...
# - Slack Incoming Webhook: https://hooks.slack.com/services/...
# - Telegram Bot Webhook: https://api.telegram.org/bot<token>/sendMessage?...
# - Zapier / Make / LeadSquared / HubSpot CRM Webhook
LEAD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Optional: Restrict Cross-Origin Requests to a specific domain (if different from same-origin)
# ALLOWED_ORIGIN=https://manjunathabatteries.in
